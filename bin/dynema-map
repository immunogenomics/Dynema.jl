#!/usr/bin/env bash
# Convenience launcher for dynema_map.jl: activates the bundled CLI
# environment (bin/Project.toml) automatically, so users only need Julia
# installed -- no `Pkg` commands, no editing this script.
#
# Usage: ./bin/dynema-map [options]      (run --help for the full list)
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Portable precompilation caches across heterogeneous machines (HPC login vs
# compute nodes with different CPUs): Julia >= 1.9 native-code caches are
# keyed to the CPU, so without this each new CPU type silently re-precompiles
# everything (minutes). On x86_64 we pin the same multi-target set Julia's
# own binaries use, making one cache valid on every node. Users can override
# by exporting JULIA_CPU_TARGET themselves. Only Linux/x86_64 (i.e. HPC)
# is pinned: single-user machines (macOS, ARM) keep native caches.
if [ "$(uname -s)" = "Linux" ] && [ "$(uname -m)" = "x86_64" ]; then
  export JULIA_CPU_TARGET="${JULIA_CPU_TARGET:-generic;sandybridge,-xsaveopt,clone_all;haswell,-rdrnd,base(1)}"
fi

# --threads N: Julia's thread count is fixed at process startup, so it is
# scanned here and passed to julia as -t N (the flag itself stays in "$@" for
# ArgParse/--help). An explicit JULIA_NUM_THREADS export takes precedence.
THREADS=""
prev=""
for a in "$@"; do
  if [ "$prev" = "--threads" ]; then THREADS="$a"; fi
  prev="$a"
done
if [ -z "${JULIA_NUM_THREADS:-}" ] && [ -n "$THREADS" ] \
   && [ "$THREADS" -gt 1 ] 2>/dev/null; then
  exec julia -t "$THREADS" --project="$DIR" "$DIR/dynema_map.jl" "$@"
fi
exec julia --project="$DIR" "$DIR/dynema_map.jl" "$@"
